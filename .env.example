# Copia questo file in ".env" (che NON va in git) e inserisci i valori veri.
# URL del progetto: Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Chiave con pieni poteri (service_role o "secret key"): solo sul tuo PC, mai in chat né in git
SUPABASE_SERVICE_ROLE_KEY=

# Solo per refresh_scores.py: connessione Postgres con la password del database (NON la service_role).
# Supabase > Connect > scheda "Direct" > Session pooler: copia la stringa intera (l'host cambia da progetto a progetto)
# e sostituisci [YOUR-PASSWORD], parentesi comprese. Password solo lettere e numeri, o i simboli vanno codificati (@ = %40).
# Forma: postgresql://postgres.<ref-progetto>:<password>@<host-del-pooler>:5432/postgres
SUPABASE_DB_URL=

# Solo per --notify (mail di esito a fine corsa).
# Google: Account > Sicurezza > Verifica in due passaggi > Password per le app: ne crei una e la incolli qui.
SMTP_USER=
SMTP_APP_PASSWORD=
# Facoltativo: destinatario (se vuoto scrive a SMTP_USER)
NOTIFY_TO=

# Facoltativi: server di posta (di base Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
